  m_Script: {fileID: 11500000, guid: 3cbb4a9a3cfd52a41a9fe51be843c439, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ScriptAlumno
  velocidadAparicion: 15
  posicionYInicial: -8
  posicionYFinal: 0.4
  dialogoPrincipal: []
  frasesGenericas: []
  botonHablarPrefab: {fileID: 2858568771042129495, guid: d7de5e6381330194bb67fbb515c3b05b, type: 3}
  posicionBoton: {x: -0.9, y: 2.3, z: 0}
  textoUI: {fileID: 2044410985}
  tiempoPorLetra: 0.02
  frasesGenericasDia1:
  - "\xBFTe puedo tocar?"
  - Hueles a pomada antihemorroidal.
  - "\xBFCada cu\xE1nto te cortas las u\xF1as?"
  - "Tengo un lagarto de mascota. Lleva haci\xE9ndose el dormido desde la semana
    pasada \xA1Que gracioso es!"
  frasesGenericasDia2:
  - "Quiero el hamster de Paco para ver c\xF3mo es su cerebro."
  - Las canicas de Juan son feas de cojones.
  - "\xBFHas o\xEDdo hablar de Luc\xEDa Fernanda? Los amigos la llamamos Lucifer."
  - "Est\xE1s muy mono cuando duermes."
  frasesGenericasDia3:
  - "Paco no me dej\xF3 su h\xE1mster\u2026  Pero lo tengo igual. Tiene el cerebro
    precioso\u2026 Aunque, despu\xE9s de haberlo visto, solo quiere jugar a hacerse
    el dormido."
  - "Hueles como la tumba de mi t\xEDo\u2026 Me encanta."
  - "\xBFCada cu\xE1nto te cortas las u\xF1as? "
  frasesGenericasDia4:
  - 
