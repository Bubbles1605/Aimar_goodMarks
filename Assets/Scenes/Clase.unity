  m_Script: {fileID: 11500000, guid: 96d402004dc52464cb19b49a110a2e6a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ScriptDias
  basicote: {fileID: 1048401725}
  brainrot: {fileID: 982342299}
  repelente: {fileID: 59642356}
  stalker: {fileID: 1940301167}
  negrete: {fileID: 867363014}
  gordete: {fileID: 405044013}
  mewing: {fileID: 2723422825153577981}
  "entrar_ni\xF1o": {fileID: 8300000, guid: 54c43cfaa4a8e54489daee1216bc4a29, type: 3}
  "entrar_ni\xF1a": {fileID: 8300000, guid: 1aa2f8d4c7aab2644bd530032b4266f5, type: 3}
  Triste_basicote: {fileID: 8300000, guid: 772d032edc1abb441ad28b5385930aae, type: 3}
  Risa_basicote: {fileID: 8300000, guid: 80643cd3166e60e468b36f18a2f6f4bd, type: 3}
  Enfado_basicote: {fileID: 8300000, guid: a76b34538b0ddbd4ba264f8580c0f018, type: 3}
  audioSource: {fileID: 1450378550}
  alumnoActual: {fileID: 1048401725}
  dialogoEnCurso: 0
  esperandoRespuesta: 0
  diaActual: 1
  objetoCartelDias: {fileID: 295012059}
  duracionCartel: 1.2
  dialogoPresentacionBasicote:
  - "\xBFEntonces t\xFA eres Mark, el nuevo profesor?"
  - "\xA1Qu\xE9 bien!"
  - "\xBFQue YO te tengo que ense\xF1ar a corregir? Hoy en d\xEDa contratan a cualquiera."
  - Usa el boli rojo para corregir el examen.
  - "Puedes hacer anotaciones, dibujos, comentarios\u2026 Lo que necesites."
  - "Puedes poner pegatinas a los ex\xE1menes si te apetece."
  - "Haz click sobre el examen para ver una vista ampliada y mu\xE9velo con la rueda
    y el click derecho."
  - Y haz click sobre el bocadillo saliente de los alumnos si quieres interactuar
    con nosotros.
  - "Cuando hayas terminado, ponle una nota al examen con los sellos para entreg\xE1rnoslo."
  basicoteReaccionFeliz:
  - "\xA1Vamonooooooos!"
  - "Me voy al parque a ense\xF1arle mis canicas a Luna."
  basicoteReaccionEnfadado:
  - "\xBFUn suspenso? \xBFEn serio?"
  - "Vaya asco de correcci\xF3n."
  basicoteReaccionTriste:
  - Tu puta madre.
  dialogoPresentacionBrainrot:
  - Skibidi toilet profe.
  - "\xBFEse examen es W o L?"
  dialogoDia2Brainrot_molesto:
  - "Hola profe, tung tung est\xE1 enfadadillo"
  - Pero no te preocupes porque yo pienso que eres un skibidi con aura.
  dialogoDia2Brainrot:
  - "Skibidi profe, estuve practicando para el examen escribiendo un mont\xF3n de
    comentarios en tis tos."
  brainrotReaccionFeliz:
  - "La procastinaci\xF3n ha dado sus frutos."
  brainrotReaccionEnfadado:
  - He perdido todo mi aura.
  brainrotReaccionTriste:
  - Bro really said suspenso.
  dialogoPresentacionListilla:
  - "Buenos d\xEDas, profesor Mark."
  - Espero mi merecido diez.
  repelenteReaccion10:
  - Como debe ser.
  - "Mi padre estar\xE1 orgulloso."
  repelenteReaccionAprobado:
  - "\xBFUn m\xEDsero a-aprobado?"
  - Esto es inaceptable.
  repelenteReaccionSuspenso:
  - "\xBFT\xDA SABES QUI\xC9N ES MI PADRE?"
  - "Est\xE1s muerto."
  dialogoPreManzanaStalker:
  - Hola.
  - Me llamo Luna.
  - "T\xFA eres Mark."
  - Toma para ti, es una simple manzana. Es para ti y SOLO para ti.
  dialogoPostManzanaStalker:
  - Ah, ya, mis ejercicios. Toma.
  stalker_5:
  - "Mejorar\xE9 por ti."
  - "Ya lo ver\xE1s."
  stalker_sonrojada:
  - Vaya, muchas gracias.
  stalkerSuspenso:
  - "Mejorar\xE9 por ti."
  - "Ya lo ver\xE1s."
  dialogoPresentacionNegrete:
  - "Epa profe, ya estoy aqu\xED."
  - "A ver qu\xE9 nota me cae."
  negreteReaccionFeliz:
  - "\xA1Toma ya! No estudi\xE9 nada."
  negreteReaccionEnfadado:
  - Jo macho, me van a castigar sin entrenos.
  negreteReaccionTriste:
  - Mis padres me matan.
  dialogoPresentacionGordete:
  - "Hola profe, \xBFhay alg\xFAn bocata por ah\xED?"
  - Tengo un hambre que me muero.
  gordeteReaccionFeliz:
  - "\xA1Me encanta esta nota! "
  - "... Me encanta el queso tambi\xE9n."
  gordeteReaccionEnfadado:
  - Con esta nota me dan ganas de morderte.
  gordeteReaccionTriste:
  - Esta nota me da arcadas.
  dialogoPresentacionMewing:
  - "Hola profe. (Te mira marcando mand\xEDbula)"
  mewingReaccionFeliz:
  - "Gracias profe. Seguir\xE9 con mi rutina de looks maxing."
  mewingReaccionEnfadado:
  - "Gracias profe. Me voy a hacer mi rutina de mewing (No parece que le importe
    nada a parte de su f\xEDsico)"
  mewingReaccionTriste:
  - "Se ha hecho tarde, tendr\xE9 que trasnochar para cumplir las 6 horas de mewing
    (No parece que le importe la nota)."
  prefabManzana: {fileID: 8959275113004482167, guid: ece185789f08a7e4aa50441372578837, type: 3}
  posicionManzanaMesa: {x: 5, y: 4.18}
  panelPantallaMuerte: {fileID: 21028750}
  nota: 0
  manzana_comida: 0
  opcionesSiNo:
  - "S\xED"
  - No
  estoyEmbelesado: 0
  haFirmadoStalker: 0
