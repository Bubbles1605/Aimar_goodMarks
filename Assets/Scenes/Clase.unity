  botonHablarPrefab: {fileID: 2858568771042129495, guid: d7de5e6381330194bb67fbb515c3b05b, type: 3}
  posicionBoton: {x: -1.15, y: 2.1, z: 0}
  textoUI: {fileID: 2044410985}
  tiempoPorLetra: 0.02
  frasesGenericasDia1:
  - "No te va a costar mucho corregir MI examen. est\xE1 perfecto."
  - "Antes Paco me ha pedido los apuntes. Me los ha devuelto y... ol\xEDan un poco
    extra\xF1o."
  - "Llevo prepar\xE1ndome el examen desde las navidades pasadas."
  - "\xA1El m\xE9todo pomodoro es lo mejor! Si tan solo no tuviese descansos..."
  frasesGenericasDia2:
  - "\xA1El m\xE9todo pomodoro es lo mejor! Si tan solo no tuviese descansos..."
  - "El muchacho del cartel no tiene ni idea de lengua, d\xEDa va con tilde."
  - "\xA1Hoy es mi d\xEDa favorito de la semana! Hacemos ejercicios de f\xEDsica
    antes de dormir."
  - "Mi padre es un cient\xEDfico reconocido a nivel internacional."
  frasesGenericasDia3:
  - "Mi padre me ha dicho que ten\xEDa mucho de lo que hablar con usted."
  - "Hugo est\xE1 cada d\xEDa m\xE1s feo."
  - "Mi padre invent\xF3 la airfryer."
  - "\xA1El m\xE9todo pomodoro es lo mejor! Si tan solo no tuviese descansos\u2026"
  frasesGenericasDia4: []
