  m_Script: {fileID: 11500000, guid: 3cbb4a9a3cfd52a41a9fe51be843c439, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ScriptAlumno
  velocidadAparicion: 15
  posicionYInicial: -8
  posicionYFinal: -0.25
  dialogoPrincipal: []
  frasesGenericas: []
  botonHablarPrefab: {fileID: 2858568771042129495, guid: d7de5e6381330194bb67fbb515c3b05b, type: 3}
  posicionBoton: {x: -0.8, y: 2.7, z: 0}
  textoUI: {fileID: 2044410985}
  tiempoPorLetra: 0.02
  frasesGenericasDia1:
  - "\xBFT\xFA est\xE1s soltero, verdad? Porque eres feo de cojones."
  - "Una persona lo suficientemente atractiva podr\xEDa hacerse con el control de
    la clase."
  - "La belleza est\xE1 en el interior. Lo importante es intentar ser mejor persona
    cada d\xEDa...   O eso es lo que diria un feo."
  - "Si te centras en cuidar tu jard\xEDn, las mariposas vendr\xE1n solas."
  frasesGenericasDia2:
  - "\xBFExamen de lengua? la lengua al paladar y a hacer mewing."
  - "Una persona lo suficientemente atractiva podr\xEDa hacerse con el control de
    la clase. "
  - "Sergio me ha dicho que me haga tis tos. Si lo hago, mucha m\xE1s gente tendr\xE1
    la oportunidad de ver mi belleza."
  - "La belleza est\xE1 en el interior. Lo importante es intentar ser mejor persona
    cada d\xEDa... O eso es lo que dir\xEDa un feo."
  frasesGenericasDia3:
  - "Gracias a Sergio estoy teniendo mucho apoyo en tis tos. Eso me hace querer trabajar
    m\xE1s mi cuerpo."
  - Hay muchos incels en tis tos.
  - "Si te centras en cuidar tu jard\xEDn, las mariposas vendr\xE1n solas."
  - "Sara me mira mucho \xFAltimamente."
  frasesGenericasDia4: []
  prefabBotonRespuesta: {fileID: 3838385740775788710, guid: 7d5e2a23cdea7e44aa5bb1c89df1b1cf, type: 3}
  contenedorRespuestas: {fileID: 493147121}
  respuestaElegida: -1
